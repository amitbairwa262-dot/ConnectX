# Copy this file to ".env" (same folder as requirements.txt). Never commit the real .env.
# Only the keys below are recognised — unknown keys make the app refuse to start.

# JWT signing key. Leave empty to auto-generate one into .secret_key (git-ignored).
# SECRET_KEY=put-a-long-random-string-here

DATABASE_URL=sqlite:///./connectx.db
UPLOAD_DIR=uploads

# Optional — only needed for the AI features (key from https://console.anthropic.com).
# Keys start with "sk-ant-".
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
